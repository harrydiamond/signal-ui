{
  "name": "@harrydiamond/signal-ui",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/tailwind.css",
    "./styles.css": "./src/styles.css",
    "./fonts.css": "./src/fonts.css"
  },
  "sideEffects": ["**/*.css"],
  "files": [
    "src"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build -o storybook-static",
    "build:storybook:chromatic": "storybook build -o storybook-static --stats-json",
    "deploy": "bun run build:storybook && wrangler deploy",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@fontsource-variable/doto": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-mcp": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.0",
    "prettier": "^3.0.0",
    "storybook": "10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.114.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun"
}
