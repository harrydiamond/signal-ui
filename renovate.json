{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "separateMultipleMajor": true,
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "lockFileMaintenance": {
    "automerge": true,
    "enabled": true,
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "description": "Do not jump more than one major version at a time",
      "matchDatasources": ["npm"],
      "allowedVersions": "<{{add major 2}}.0.0"
    },
    {
      "matchDepTypes": ["devDependencies"],
      "automerge": true,
      "matchPackageNames": ["/lint/", "/prettier/"]
    },
    {
      "description": "Group React packages into one PR",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "groupName": "react"
    },
    {
      "description": "Group Tailwind CSS packages into one PR",
      "matchPackageNames": [
        "tailwindcss",
        "@tailwindcss/**",
        "tailwind-merge",
        "tailwind-variants"
      ],
      "groupName": "tailwind"
    },
    {
      "description": "Group Cloudflare packages into one PR",
      "matchPackageNames": ["wrangler", "@cloudflare/**"],
      "groupName": "cloudflare"
    },
    {
      "description": "Group Storybook packages into one PR",
      "matchPackageNames": ["storybook", "@storybook/**"],
      "groupName": "storybook"
    },
    {
      "description": "Group Vite packages into one PR",
      "matchPackageNames": ["vite", "@vitejs/**"],
      "groupName": "vite"
    },
    {
      "description": "Group Vitest packages into one PR",
      "matchPackageNames": ["vitest", "@vitest/**"],
      "groupName": "vitest"
    },
    {
      "description": "Group Testing Library packages into one PR",
      "matchPackageNames": ["@testing-library/**"],
      "groupName": "testing-library"
    },
    {
      "description": "Group Prettier packages into one PR",
      "matchPackageNames": ["/prettier/"],
      "groupName": "prettier"
    }
  ]
}
